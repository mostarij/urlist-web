{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "types": ["astro/client"],
    "module": "ESNext",
    "allowImportingTsExtensions": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
