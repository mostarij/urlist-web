---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'url' | 'email' | 'password';
  required?: boolean;
  placeholder?: string;
  value?: string;
  pattern?: string;
  helpText?: string;
  error?: string;
}

const {
  label,
  name,
  type = 'text',
  required = false,
  placeholder,
  value,
  pattern,
  helpText,
  error,
} = Astro.props;

const id = `field-${name}`;
---

<div class="space-y-1">
  <label for={id} class="block text-sm font-medium text-gray-700">
    {label}
    {required && <span class="text-red-500">*</span>}
  </label>
  
  <input
    type={type}
    id={id}
    name={name}
    value={value}
    pattern={pattern}
    required={required}
    placeholder={placeholder}
    class:list={[
      'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent',
      error ? 'border-red-500' : 'border-gray-300',
    ]}
    data-validate={type === 'url' ? 'true' : undefined}
  />
  
  {(error || helpText) && (
    <p class:list={[
      'text-sm',
      error ? 'text-red-500' : 'text-gray-500'
    ]}>
      {error || helpText}
    </p>
  )}
</div>

<script>
  import { validateUrlInput, debounce } from '../utils/form-validation';
  
  // Set up URL validation
  const urlInputs = document.querySelectorAll<HTMLInputElement>('input[data-validate="true"]');
  
  urlInputs.forEach(input => {
    const validateDebounced = debounce(() => validateUrlInput(input), 300);
    input.addEventListener('input', validateDebounced);
    input.addEventListener('blur', () => validateUrlInput(input));
  });
</script>
