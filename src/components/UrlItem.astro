---
import type { UrlItem } from '../types/url-list';
import Button from './Button.astro';
import FormField from './FormField.astro';

interface Props {
  item: UrlItem;
  isEditing?: boolean;
  onDelete?: () => void;
}

const { item, isEditing = false } = Astro.props;
---

<div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between">
    <div class="flex-1">
      {isEditing ? (
        <form method="POST" class="space-y-3" data-edit-url-form>
          <input type="hidden" name="action" value="updateUrl" />
          <input type="hidden" name="urlId" value={item.id} />
          
          <div>
            <label class="block text-sm text-gray-600 mb-1">URL</label>          <FormField
            label="URL"
            name="url"
            type="url"
            value={item.url}
            required
          />
          </div>
          
          <div>
            <label class="block text-sm text-gray-600 mb-1">Title (optional)</label>
            <input 
              type="text" 
              name="title"
              value={item.title}
              class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>
          
          <div>
            <label class="block text-sm text-gray-600 mb-1">Description (optional)</label>
            <textarea 
              name="description"
              rows="2"
              class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >{item.description}</textarea>
          </div>
          
          <div class="flex justify-end space-x-3">
            <Button type="submit" size="sm">Save</Button>
            <Button 
              type="button" 
              variant="secondary" 
              size="sm"
              class="cancel-edit-btn"
            >
              Cancel
            </Button>
<script>
  document.querySelectorAll('.cancel-edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('[data-edit-url-form]')?.reset();
    });
  });
</script>
          </div>
        </form>
      ) : (
        <a 
          href={item.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-blue-600 hover:text-blue-800 font-medium break-all"
        >
          {item.url}
        </a>
      )}
      
      {item.title && (
        <h4 class="text-gray-900 font-medium mt-2">
          {item.title}
        </h4>
      )}
      
      {item.description && (
        <p class="text-gray-600 text-sm mt-1">
          {item.description}
        </p>
      )}
    </div>
    
    {isEditing && (
      <button
        class="ml-4 text-red-500 hover:text-red-700"
        onclick="document.dispatchEvent(new CustomEvent('deleteUrlItem', { detail: { id: item.id } }))"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm4 0a1 1 0 012 0v6a1 1 0 11-2 0V8z" clip-rule="evenodd" />
        </svg>
      </button>
    )}
  </div>
</div>
