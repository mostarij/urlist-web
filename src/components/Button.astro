---
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  name?: string;
  value?: string;
  onclick?: string;
  class?: string;
}

const props = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-lg transition-colors duration-200 shadow-lg hover:shadow-xl';

const variantStyles = {
  primary: 'bg-blue-600 text-white hover:bg-blue-700',
  secondary: 'bg-white text-blue-600 hover:bg-gray-50 border border-gray-200',
};

const sizeStyles = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const classes = `${baseStyles} ${variantStyles[props.variant || 'primary']} ${sizeStyles[props.size || 'md']} ${props.class || ''}`;
---

{props.href ? (
  <a href={props.href} class={classes}>
    <slot />
  </a>
) : (
  <button
    type={props.type || 'button'}
    class={classes}
    name={props.name}
    value={props.value}
    onclick={props.onclick}
  >
    <slot />
  </button>
)}
