---
import type { UrlList } from '../types/url-list';
import Button from './Button.astro';

interface Props {
  list: UrlList;
}

const { list } = Astro.props;
const shareUrl = `${Astro.url.origin}/${list.customSlug || list.generatedSlug}`;
const itemCount = Array.isArray(list.items) ? list.items.length : 0;
const formattedDate = new Date(list.createdAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200 p-6">
  <div class="flex justify-between items-start mb-4">
    <h3 class="text-xl font-semibold text-gray-900">{list.title}</h3>
  </div>
  
  <div class="text-sm text-gray-500 mb-4">
    {itemCount} {itemCount === 1 ? 'URL' : 'URLs'} • Created {formattedDate}
  </div>
  
  <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
    <div class="flex items-center space-x-2">
      <span class={`w-2 h-2 rounded-full ${list.isPublished ? 'bg-green-500' : 'bg-gray-300'}`}></span>
      <span class="text-sm text-gray-600">
        {list.isPublished ? 'Published' : 'Draft - Click Edit to Publish'}
      </span>
    </div>
    <div class="flex space-x-2">
      <form method="POST" onsubmit="return confirm('Are you sure you want to delete this list?')">
        <input type="hidden" name="action" value="deleteList" />
        <input type="hidden" name="listId" value={list.id} />
        <Button type="submit" variant="danger" size="sm">Delete</Button>
      </form>
      <Button variant="secondary" size="sm" href={`/lists/${list.id}/edit`}>Edit</Button>
      <Button variant="primary" size="sm" href={`/lists/${list.id}/view`}>View</Button>
    </div>
  </div>
</div>
