---
import type { UrlList } from '../types/url-list';
import Button from './Button.astro';
import ShareMenu from './ShareMenu.astro';

interface Props {
  list: UrlList;
}

const { list } = Astro.props;
const shareUrl = `${Astro.url.origin}/${list.customSlug || list.generatedSlug}`;
---

<div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
  <div class="flex justify-between items-start mb-4">
    <h3 class="text-xl font-semibold text-gray-900">{list.title}</h3>
    <div class="flex space-x-2">
      <Button 
        variant="secondary" 
        size="sm" 
        href={`/lists/${list.id}/edit`}
      >
        Edit
      </Button>
      <Button
        variant="primary"
        size="sm"
        href={shareUrl}
      >
        View
      </Button>
    </div>
  </div>
  
  <div class="text-sm text-gray-500 mb-4">
    {list.items?.length || 0} URLs • Created {new Date(list.createdAt).toLocaleDateString()}
  </div>
  
  <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
    <div class="flex items-center space-x-2">
      <span class={`w-2 h-2 rounded-full ${list.isPublished ? 'bg-green-500' : 'bg-gray-300'}`}></span>
      <span class="text-sm text-gray-600">
        {list.isPublished ? 'Published' : 'Draft'}
      </span>
    </div>
    <ShareMenu url={shareUrl} title={list.title} />
  </div>
</div>
