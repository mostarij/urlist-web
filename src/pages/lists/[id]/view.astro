---
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import UrlItem from '../../../components/UrlItem.astro';
import LoadingSpinner from '../../../components/LoadingSpinner.astro';
import { getUrlList } from '../../../db/url-list-repository';

export const prerender = false;

const { id } = Astro.params;
let list = null;
let error = '';
let loading = true;

try {
  if (!id) throw new Error('Invalid list ID');
  list = await getUrlList(id);
  
  if (!list) {
    return Astro.redirect('/404');
  }
  loading = false;
} catch (e) {
  loading = false;
  error = e instanceof Error ? e.message : 'An unexpected error occurred';
}

const items = Array.isArray(list?.items) ? list.items : [];
const shareUrl = `${Astro.url.origin}/${list?.customSlug || list?.generatedSlug}`;
---

<Layout title={list ? list.title : 'View List'}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    {loading && (
      <div class="flex justify-center py-12">
        <LoadingSpinner size="lg" />
      </div>
    )}

    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
        {error}
      </div>
    )}

    {list && !loading && (
      <div>
        <div class="flex justify-between items-start mb-8">
          <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">{list.title}</h1>
            <div class="text-sm text-gray-500">
              {items.length} URLs • Last updated {new Date(list.updatedAt).toLocaleDateString()}
            </div>
          </div>
          <div class="flex space-x-3">
            <Button
              variant="secondary"
              onclick={`navigator.clipboard.writeText('${shareUrl}')`}
              type="button"
            >
              Copy Link
            </Button>
            {list.userId === '123' && (
              <Button href={`/lists/${list.id}/edit`}>
                Edit List
              </Button>
            )}
          </div>
        </div>

        <div class="space-y-4">
          {items.map(item => (
            <UrlItem item={item} isEditing={false} />
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
