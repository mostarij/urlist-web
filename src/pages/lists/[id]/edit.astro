---
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import UrlItem from '../../../components/UrlItem.astro';
import LoadingSpinner from '../../../components/LoadingSpinner.astro';
import Toast from '../../../components/Toast.astro';
import ErrorBoundary from '../../../components/ErrorBoundary.astro';
import { getUrlList, updateUrlList, addUrlItem, deleteUrlItem } from '../../db/url-list-repository';
import { fetchUrlMetadata } from '../../utils/url-metadata';

const { id } = Astro.params;
let list;
let error = '';
let success = '';

try {
  list = await getUrlList(id);
  
  if (!list) {
    return Astro.redirect('/404');
  }

  // Handle form submissions
  if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const action = formData.get('action') as string;

    switch (action) {
      case 'addUrl': {
        const url = formData.get('url') as string;
        validateUrl(url);
        const metadata = await fetchUrlMetadata(url);
        await addUrlItem(list.id, { url, ...metadata });
        success = 'URL added successfully';
        break;
      }
      case 'updateList': {
        const title = formData.get('title') as string;
        const customSlug = formData.get('customSlug') as string;
        const isPublished = formData.get('isPublished') === 'true';
        
        if (customSlug) {
          validateSlug(customSlug);
          if (!await isSlugAvailable(customSlug) && customSlug !== list.customSlug) {
            throw new ValidationError('This custom URL is already taken');
          }
        }
        
        await updateUrlList(list.id, { title, customSlug, isPublished });
        success = 'List updated successfully';
        break;
      }
      case 'deleteUrl': {
        const urlId = formData.get('urlId') as string;
        await deleteUrlItem(urlId);
        success = 'URL deleted successfully';
        break;
      }
    }
    
    // Refresh list data after modifications
    list = await getUrlList(id);
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'An unexpected error occurred';
}

const shareUrl = list ? `${Astro.url.origin}/${list.customSlug || list.generatedSlug}` : '';

// Import validation utilities
import { validateUrl, validateSlug, ValidationError } from '../../../utils/validation';

// State for error messages
let errorMessage = '';
let successMessage = '';

// Handle form submissions
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  try {
    switch (action) {
      case 'addUrl':
        const url = formData.get('url') as string;
        validateUrl(url);
        const metadata = await fetchUrlMetadata(url);
        await addUrlItem(list.id, { url, ...metadata });
        successMessage = 'URL added successfully';
        break;

      case 'updateList':
        const title = formData.get('title') as string;
        const customSlug = formData.get('customSlug') as string;
        const isPublished = formData.get('isPublished') === 'true';
        
        if (customSlug) {
          validateSlug(customSlug);
          if (!await isSlugAvailable(customSlug) && customSlug !== list.customSlug) {
            throw new ValidationError('This custom URL is already taken');
          }
        }
        
        await updateUrlList(list.id, { title, customSlug, isPublished });
        successMessage = 'List updated successfully';
        break;

      case 'deleteUrl':
        const urlId = formData.get('urlId') as string;
        await deleteUrlItem(urlId);
        break;
    }

    // Redirect to refresh the page
    return Astro.redirect(`/lists/${id}/edit`);
  } catch (error) {
    console.error('Error updating list:', error);
  }
}

const shareUrl = `${Astro.url.origin}/${list.customSlug || list.generatedSlug}`;
---

<Layout title={list ? `Edit: ${list.title}` : 'Error'}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    {error && <ErrorBoundary error={new Error(error)} />}
    {success && <Toast type="success" message={success} />}
    
    {list && (
      <form method="POST" class="space-y-8">
        <input type="hidden" name="action" value="updateList" />
      
      <div class="flex items-start justify-between">
        <div class="space-y-4 flex-1 max-w-2xl">
          <div>
            <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
              List Title
            </label>
            <input
              type="text"
              id="title"
              name="title"
              value={list.title}
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div>
            <label for="customSlug" class="block text-sm font-medium text-gray-700 mb-1">
              Custom URL
            </label>
            <div class="flex items-center">
              <span class="text-gray-500 bg-gray-50 px-3 py-2 border border-r-0 border-gray-300 rounded-l-lg">
                {Astro.url.origin}/
              </span>
              <input
                type="text"
                id="customSlug"
                name="customSlug"
                value={list.customSlug}
                pattern="[a-zA-Z0-9-]+"
                class="flex-1 px-4 py-2 border border-gray-300 rounded-r-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
          </div>
        </div>

        <div class="ml-8 flex items-center space-x-4">
          <Button
            type="submit"
            name="isPublished"
            value={(!list.isPublished).toString()}
          >
            {list.isPublished ? 'Unpublish' : 'Publish'}
          </Button>
          <Button
            variant="secondary"
            onclick={`navigator.clipboard.writeText('${shareUrl}')`}
            type="button"
          >
            Copy Link
          </Button>
        </div>
      </div>

      <div class="border-t border-gray-200 pt-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">URLs in this list</h2>
        
        <div class="space-y-4 mb-8">
          {list.items?.map((item) => (
            <UrlItem item={item} isEditing={true} />
          ))}
        </div>

        <form method="POST" class="flex space-x-4" id="addUrlForm">
          <input type="hidden" name="action" value="addUrl" />
          <input
            type="url"
            name="url"
            required
            placeholder="Enter a URL to add to the list"
            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <Button type="submit">
            Add URL
          </Button>
        </form>
      </div>
    </form>
  </div>
</Layout>

<script>
  // Handle URL item deletion
  document.addEventListener('deleteUrlItem', (e) => {
    const form = document.createElement('form');
    form.method = 'POST';
    form.innerHTML = `
      <input type="hidden" name="action" value="deleteUrl" />
      <input type="hidden" name="urlId" value="${e.detail.id}" />
    `;
    document.body.appendChild(form);
    form.submit();
  });
</script>
