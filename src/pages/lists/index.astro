---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import UrlListCard from '../../components/UrlListCard.astro';
import { getOrCreateDemoUser } from '../../db/user-repository';
import { getUserUrlLists, deleteUrlList } from '../../db/url-list-repository';

export const prerender = false;

let lists = [];
let error: string | undefined;
let success: string | undefined;

try {
  const user = await getOrCreateDemoUser();

  if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const action = formData.get('action');
    
    if (action === 'deleteList') {
      const listId = formData.get('listId') as string;
      await deleteUrlList(listId);
      success = 'List deleted successfully';
    }
  }

  lists = await getUserUrlLists(user.id);
} catch (e) {
  error = 'Failed to load lists';
  console.error('Error loading lists:', e);
}

const sortedLists = lists.sort((a, b) => 
  new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
);
---

<Layout title="My Lists">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900">My Lists</h1>
      <Button href="/lists/new">
        Create New List
      </Button>
    </div>

    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-6">
        {error}
      </div>
    )}
    
    {success && (
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-6">
        {success}
      </div>
    )}
    
    {lists.length === 0 ? (
      <div class="text-center py-12">
        <h2 class="text-xl font-semibold text-gray-700 mb-2">No Lists Yet</h2>
        <p class="text-gray-600 mb-6">Create your first list to get started</p>
        <Button href="/lists/new">
          Create Your First List
        </Button>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sortedLists.map(list => (
          <UrlListCard list={list} />
        ))}
      </div>
    )}
  </div>
</Layout>
