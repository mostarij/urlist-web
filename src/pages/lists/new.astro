---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { createUrlList } from '../../db/url-list-repository';
import { getOrCreateDemoUser } from '../../db/user-repository';

export const prerender = false; // Ensure server-side rendering

let error: string | undefined;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const title = formData.get('title')?.toString();
    const customSlug = formData.get('customSlug')?.toString();

    if (!title) {
      error = 'Title is required';
    } else {
      const user = await getOrCreateDemoUser();
      const list = await createUrlList(user.id, {
        title,
        customSlug: customSlug || undefined
      });
      return Astro.redirect(`/lists/${list.id}/edit`);
    }
  } catch (e) {
    error = 'Failed to create list';
    console.error('Error creating list:', e);
  }
}
---

<Layout title="Create New List">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Create New List</h1>

    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-6">
        {error}
      </div>
    )}

    <form 
      method="POST" 
      class="space-y-6"
    >
      <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
          List Title
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          placeholder="Enter a title for your list"
        />
      </div>

      <div>
        <label for="customSlug" class="block text-sm font-medium text-gray-700 mb-1">
          Custom URL (optional)
        </label>
        <div class="flex items-center">
          <span class="text-gray-500 bg-gray-50 px-3 py-2 border border-r-0 border-gray-300 rounded-l-lg">
            {Astro.url.origin}/
          </span>
          <input
            type="text"
            id="customSlug"
            name="customSlug"
            pattern="[a-zA-Z0-9-]+"
            class="flex-1 px-4 py-2 border border-gray-300 rounded-r-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="my-awesome-list"
          />
        </div>
        <p class="mt-1 text-sm text-gray-500">
          Letters, numbers, and hyphens only. Leave blank for an auto-generated URL.
        </p>
      </div>

      <div class="flex justify-end space-x-4">
        <Button href="/" variant="secondary">
          Cancel
        </Button>
        <Button type="submit">
          Create List
        </Button>
      </div>
    </form>
  </div>
</Layout>
