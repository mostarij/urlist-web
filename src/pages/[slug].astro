---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import UrlItem from '../components/UrlItem.astro';
import { getUrlList } from '../db/url-list-repository';

export const prerender = false;

const { slug } = Astro.params;
let list;
let error;
let notFound = false;

try {
  list = await getUrlList(slug);
  
  if (!list) {
    notFound = true;
    return Astro.redirect('/404');
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'An unexpected error occurred';
  console.error('Error loading list:', e);
}

if (notFound) {
  return Astro.redirect('/404');
}

const items = Array.isArray(list?.items) ? list.items : [];
---

<Layout title={list ? list.title : 'View List'}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
        {error}
      </div>
    )}
    <div>
      <div class="flex justify-between items-start mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">{list.title}</h1>
          <div class="text-sm text-gray-500">
            {items.length} URLs • Last updated {new Date(list.updatedAt).toLocaleDateString()}
          </div>
        </div>
        <Button
          variant="secondary"
          onclick={`navigator.clipboard.writeText('${Astro.url.href}')`}
          type="button"
        >
          Copy Link
        </Button>
      </div>

      <div class="space-y-4">
        {items.map(item => (
          <UrlItem item={item} isEditing={false} />
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  // Add copy feedback
  document.querySelector('button')?.addEventListener('click', () => {
    const button = document.querySelector('button');
    const originalText = button.textContent;
    button.textContent = 'Copied!';
    setTimeout(() => {
      button.textContent = originalText;
    }, 2000);
  });
</script>
