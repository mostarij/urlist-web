---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import UrlItem from '../components/UrlItem.astro';
import { getUrlList } from '../db/url-list-repository';

export const prerender = false;

const { slug } = Astro.params;
let list;
let error;
let notFound = false;

try {
  if (!slug) {
    return Astro.redirect('/404');
  }
  
  list = await getUrlList(slug);
  
  if (!list) {
    notFound = true;
    return Astro.redirect('/404');
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'An unexpected error occurred';
  console.error('Error loading list:', e);
}

// Add type assertion for list after validation
if (!list || notFound) {
  return Astro.redirect('/404');
}

const items = Array.isArray(list.items) ? list.items : [];
const safeList = list; // Type assertion after validation
---

<Layout title={safeList.title}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
        {error}
      </div>
    )}
    
    <div>
      <div class="flex justify-between items-start mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">{safeList.title}</h1>
          <div class="text-sm text-gray-500">
            {items.length} URLs • Last updated {new Date(safeList.updatedAt).toLocaleDateString()}
          </div>
        </div>
        <Button
          variant="secondary"
          onclick={`navigator.clipboard.writeText('${Astro.url.href}')`}
          type="button"
        >
          Copy Link
        </Button>
      </div>

      <div class="space-y-4">
        {items.map(item => (
          <UrlItem item={item} isEditing={false} />
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  // Add copy feedback with proper null checks
  const copyButton = document.querySelector('button[type="button"]');
  if (copyButton) {
    copyButton.addEventListener('click', () => {
      const originalText = copyButton.textContent || 'Copy Link';
      copyButton.textContent = 'Copied!';
      setTimeout(() => {
        copyButton.textContent = originalText;
      }, 2000);
    });
  }
</script>
